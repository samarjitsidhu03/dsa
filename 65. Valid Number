class Solution {
public:
    bool isNumber(string s) {
        int i = 0, n = s.size();
        while (i < n && s[i] == ' ') i++;
        if (i < n && (s[i] == '+' || s[i] == '-')) i++;
        bool num = false, dot = false;
        while (i < n && (isdigit(s[i]) || s[i] == '.')) {
            if (s[i] == '.') {
                if (dot) return false;
                dot = true;
            } else {
                num = true;
            }
            i++;
        }
        if (!num) return false;
        if (i < n && (s[i] == 'e' || s[i] == 'E')) {
            i++;
            if (i < n && (s[i] == '+' || s[i] == '-')) i++;
            bool expNum = false;
            while (i < n && isdigit(s[i])) {
                expNum = true;
                i++;
            }
            if (!expNum) return false;
        }
        while (i < n && s[i] == ' ') i++;
        return i == n;
    }
};
