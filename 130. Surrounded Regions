class Solution {
public:
    void solve(vector<vector<char>>& board) {
        int m = board.size(), n = board[0].size();
        queue<pair<int,int>> q;
        for(int i = 0; i < m; i++) {
            if(board[i][0] == 'O') q.push({i, 0});
            if(board[i][n-1] == 'O') q.push({i, n-1});
        }
        for(int j = 0; j < n; j++) {
            if(board[0][j] == 'O') q.push({0, j});
            if(board[m-1][j] == 'O') q.push({m-1, j});
        }
        while(!q.empty()) {
            auto [r, c] = q.front();
            q.pop();
            if(r < 0 || r >= m || c < 0 || c >= n || board[r][c] != 'O')
                continue;
            board[r][c] = '#';

            q.push({r+1, c});
            q.push({r-1, c});
            q.push({r, c+1});
            q.push({r, c-1});
        }
        for(int i = 0; i < m; i++) {
            for(int j = 0; j < n; j++) {
                if(board[i][j] == 'O')
                    board[i][j] = 'X';
                else if(board[i][j] == '#')
                    board[i][j] = 'O';
            }
        }
    }
};
