class Solution {
public:
    vector<vector<int>> subsets(vector<int>& nums) {
         vector<vector<int>> ans;
        vector<int> temp;
        function<void(int)> backtrack = [&](int idx) {
            ans.push_back(temp);
        for (int i = idx; i < nums.size(); i++) {
                temp.push_back(nums[i]);
                backtrack(i + 1);
                temp.pop_back();
            }
        };
        backtrack(0);
        return ans; 
    }
};
