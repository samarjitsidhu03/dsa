class Solution {
public:
    bool isBalanced(TreeNode* root) {
        return isdepth(root)!=-1;    
    }
    int isdepth(TreeNode *root){
        if (root==NULL) return 0;
        int lh=isdepth(root->left);
        if(lh==-1) return -1;
        int rh=isdepth(root->right);
        if(rh==-1) return -1;
        if (abs(lh - rh) > 1) return -1;
        return max(lh,rh)+1;
    }
};
