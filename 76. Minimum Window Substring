class Solution {
public:
    string minWindow(string s, string t) {
        vector<int> freq(128, 0);
        for(char ch : t) {
            freq[ch]++;
        }
        int left = 0;
        int right = 0;
        int required = t.size();
        int start = 0;
        int minLength = INT_MAX;
        while(right < s.size()) {
            if(freq[s[right]] > 0) {
                required--;
            }
            freq[s[right]]--;
            right++;
            while(required == 0) {
                if(right - left < minLength) {
                    minLength = right - left;
                    start = left;
                }
                freq[s[left]]++;
                if(freq[s[left]] > 0) {
                    required++;
                }
                left++;
            }
        }
        if(minLength == INT_MAX) {
            return "";
        }
        return s.substr(start, minLength);
    }
};
